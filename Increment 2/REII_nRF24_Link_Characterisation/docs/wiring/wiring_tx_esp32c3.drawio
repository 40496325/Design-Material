<mxfile host="Electron" type="device"><diagram name="TX - ESP32-C3" id="TX_ESP32_C3"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="900" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="Transmitter / mobile node: ESP32-C3 dev board  +  nRF24L01+ PA+LNA" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1100" height="40" as="geometry"/></mxCell><mxCell id="c2" value="REII checkpoint - nRF24L01+ (PA+LNA) link bring-up. Pin numbers are GPIO numbers as used in firmware/lib/linktest/board_pins.h; see docs/02_wiring.md." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="60" width="1100" height="24" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b&gt;ESP32-C3 dev board&lt;/b&gt;&lt;br&gt;role: tx&lt;br&gt;(battery powered during the distance sweep)" style="rounded=1;whiteSpace=wrap;html=1;strokeWidth=2;fontSize=13;fillColor=#FFE6CC;verticalAlign=top;spacingTop=8;fontSize=14;" vertex="1" parent="1"><mxGeometry x="120" y="140" width="300" height="560" as="geometry"/></mxCell><mxCell id="c4" value="GND" style="rounded=0;whiteSpace=wrap;html=1;strokeWidth=1;fontSize=11;fillColor=#FFFFFF;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="330" y="250" width="90" height="26" as="geometry"/></mxCell><mxCell id="c5" value="3V3" style="rounded=0;whiteSpace=wrap;html=1;strokeWidth=1;fontSize=11;fillColor=#FFFFFF;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="330" y="302" width="90" height="26" as="geometry"/></mxCell><mxCell id="c6" value="on-board LDO" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontSize