onalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=none;strokeWidth=3;strokeColor=#808080;exitX=1;exitY=0.5;entryX=0;entryY=0.5;fontSize=10;fontColor=#808080;labelBackgroundColor=#FFFFFF;dashed=1;" edge="1" parent="1" source="c16" target="c39"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c52" value="" style="endArrow=none;html=1;strokeWidth=3;rounded=0;strokeColor=#D40000;jumpStyle=arc;jumpSize=12;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="700" y="315" as="sourcePoint"/><mxPoint x="700" y="160" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c53" value="" style="endArrow=none;html=1;strokeWidth=3;rounded=0;strokeColor=#D40000;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="700" y="160" as="sourcePoint"/><mxPoint x="790" y="160" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c54" value="" style="ellipse;fillColor=#000000;strokeColor=none;fillColor=#D40000;" vertex="1" parent="1"><mxGeometry x="695" y="310" width="10" height="10" as="geometry"/></mxCell><mxCell id="c55" value="" style="shape=mxgraph.electrical.capacitors.capacitor_1;html=1;strokeWidth=2;rotation=90;pointerEvents=1;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="700" y="196.5" width="60" height="30" as="geometry"/></mxCell><mxCell id="c56" value="10 uF" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontSize=10;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="744" y="201.5" width="60" height="20" as="geometry"/></mxCell><mxCell id="c57" value="" style="endArrow=none;html=1;strokeWidth=3;rounded=0;strokeColor=#D40000;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="730" y="160" as="sourcePoint"/><mxPoint x="730" y="181.5" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c58" value="" style="endArrow=none;html=1;strokeWidth=3;rounded=0;strokeColor=#000000;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="730" y="241.5" as="sourcePoint"/><mxPoint x="730" y="263" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c59" value="" style="ellipse;fillColor=#000000;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="725" y="258" width="10" height="10" as="geometry"/></mxCell><mxCell id="c60" value="" style="shape=mxgraph.electrical.capacitors.capacitor_1;html=1;strokeWidth=2;rotation=90;pointerEvents=1;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="760" y="196.5" width="60" height="30" as="geometry"/></mxCell><mxCell id="c61" value="100 nF" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontSize=10;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="804" y="201.5" width="60" height="20" as="geometry"/></mxCell><mxCell id="c62" value="" style="endArrow=none;html=1;strokeWidth=3;rounded=0;strokeColor=#D40000;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="790" y="160" as="sourcePoint"/><mxPoint x="790" y="181.5" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c63" value="" style="endArrow=none;html=1;strokeWidth=3;rounded=0;strokeColor=#000000;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="790" y="241.5" as="sourcePoint"/><mxPoint x="790" y="263" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c64" value="" style="ellipse;fillColor=#000000;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="785" y="258" width="10" height="10" as="geometry"/></mxCell><mxCell id="c65" value="decoupling AT the module header:&lt;br&gt;10 uF (electrolytic / tantalum)&lt;br&gt;+ 100 nF (ceramic)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontSize=10;align=right;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="520" y="140" width="170" height="60" as="geometry"/></mxCell><mxCell id="c66" value="&lt;b&gt;USB power bank / PC USB&lt;/b&gt;&lt;br&gt;mini-USB, 5 V" style="rounded=1;whiteSpace=wrap;html=1;strokeWidth=2;fontSize=13;fillColor=#F5F5F5;fontSize=12;" vertex="1" parent="1"><mxGeometry x="120" y="730" width="300" height="60" as="geometry"/></mxCell><mxCell id="c67" value="USB 5 V" style="endArrow=block;html=1;strokeWidth=2;rounded=1;edgeStyle=orthogonalEdgeStyle;exitX=0.5;exitY=0;entryX=0.5;entryY=1;" edge="1" parent="1" source="c66"><mxGeometry relative="1" as="geometry"><mxPoint x="270.0" y="700" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c68" value="Do NOT use the Nano&#x27;s own 3V3 pin: it comes from the FT232/CH340 USB chip and is limited to ~50 mA - the PA+LNA module needs &amp;gt; 100 mA bursts. Put the LDO output (3.3 V) on module pin 2." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontSize=10;" vertex="1" parent="1"><mxGeometry x="440" y="730" width="380" height="80" as="geometry"/></mxCell><mxCell id="c69" value="&lt;b&gt;Notes&lt;/b&gt;&lt;br&gt;&amp;#8226; Nano drives 5 V logic into the nRF24 SPI inputs; the nRF24L01+ inputs are 5 V tolerant when VDD = 3.3 V (datasheet), so no level shifter is required on the breadboard - but the STM32/ESP32 production path will be 3.3 V anyway.&lt;br&gt;&amp;#8226; Fixed SPI pins on the Nano: D13 SCK, D11 MOSI, D12 MISO.&lt;br&gt;&amp;#8226; Keep SPI leads short (&amp;lt; 10 cm) on the breadboard; the firmware runs SPI at 4 MHz for this reason.&lt;br&gt;&amp;#8226; IRQ (dashed) is optional - the firmware polls; leave it unconnected if you are short of pins.&lt;br&gt;&amp;#8226; Check with a multimeter: 3.3 V across module header pins 1-2 under load, before the first pio run -t upload." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontSize=10;" vertex="1" parent="1"><mxGeometry x="860" y="730" width="520" height="170" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>