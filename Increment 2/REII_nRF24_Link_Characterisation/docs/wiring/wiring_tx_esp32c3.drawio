 x="700" y="315" as="sourcePoint"/><mxPoint x="700" y="160" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c49" value="" style="endArrow=none;html=1;strokeWidth=3;rounded=0;strokeColor=#D40000;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="700" y="160" as="sourcePoint"/><mxPoint x="790" y="160" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c50" value="" style="ellipse;fillColor=#000000;strokeColor=none;fillColor=#D40000;" vertex="1" parent="1"><mxGeometry x="695" y="310" width="10" height="10" as="geometry"/></mxCell><mxCell id="c51" value="" style="shape=mxgraph.electrical.capacitors.capacitor_1;html=1;strokeWidth=2;rotation=90;pointerEvents=1;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="700" y="196.5" width="60" height="30" as="geometry"/></mxCell><mxCell id="c52" value="10 uF" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontSize=10;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="744" y="201.5" width="60" height="20" as="geometry"/></mxCell><mxCell id="c53" value="" style="endArrow=none;html=1;strokeWidth=3;rounded=0;strokeColor=#D40000;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="730" y="160" as="sourcePoint"/><mxPoint x="730" y="181.5" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c54" value="" style="endArrow=none;html=1;strokeWidth=3;rounded=0;strokeColor=#000000;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="730" y="241.5" as="sourcePoint"/><mxPoint x="730" y="263" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c55" value="" style="ellipse;fillColor=#000000;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="725" y="258" width="10" height="10" as="geometry"/></mxCell><mxCell id="c56" value="" style="shape=mxgraph.electrical.capacitors.capacitor_1;html=1;strokeWidth=2;rotation=90;pointerEvents=1;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="760" y="196.5" width="60" height="30" as="geometry"/></mxCell><mxCell id="c57" value="100 nF" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontSize=10;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="804" y="201.5" width="60" height="20" as="geometry"/></mxCell><mxCell id="c58" value="" style="endArrow=none;html=1;strokeWidth=3;rounded=0;strokeColor=#D40000;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="790" y="160" as="sourcePoint"/><mxPoint x="790" y="181.5" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c59" value="" style="endArrow=none;html=1;strokeWidth=3;rounded=0;strokeColor=#000000;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="790" y="241.5" as="sourcePoint"/><mxPoint x="790" y="263" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c60" value="" style="ellipse;fillColor=#000000;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="785" y="258" width="10" height="10" as="geometry"/></mxCell><mxCell id="c61" value="decoupling AT the module header:&lt;br&gt;10 uF (electrolytic / tantalum)&lt;br&gt;+ 100 nF (ceramic)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontSize=10;align=right;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="520" y="140" width="170" height="60" as="geometry"/></mxCell><mxCell id="c62" value="&lt;b&gt;USB power bank&lt;/b&gt;&lt;br&gt;(or PC USB for bench / serial BEACON mode)" style="rounded=1;whiteSpace=wrap;html=1;strokeWidth=2;fontSize=13;fillColor=#F5F5F5;fontSize=12;" vertex="1" parent="1"><mxGeometry x="120" y="730" width="300" height="60" as="geometry"/></mxCell><mxCell id="c63" value="USB 5 V" style="endArrow=block;html=1;strokeWidth=2;rounded=1;edgeStyle=orthogonalEdgeStyle;exitX=0.5;exitY=0;entryX=0.5;entryY=1;" edge="1" parent="1" source="c62"><mxGeometry relative="1" as="geometry"><mxPoint x="270.0" y="700" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c64" value="Some power banks switch off below ~50 mA; the TX idles in Standby-I between bursts. If the bank cuts out, add a small keep-alive load or use a bank without auto-off." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontSize=10;" vertex="1" parent="1"><mxGeometry x="440" y="730" width="380" height="80" as="geometry"/></mxCell><mxCell id="c65" value="&lt;b&gt;Notes&lt;/b&gt;&lt;br&gt;&amp;#8226; Avoid GPIO2/8/9 (strapping), GPIO12-17 (module flash), GPIO18/19 (USB-JTAG), GPIO20/21 (UART0).&lt;br&gt;&amp;#8226; nRF24 VCC is 3.3 V ONLY (1.9-3.6 V abs. max) - never 5 V. Signals are 5 V tolerant on the 3.3 V-powered chip, but all boards here are 3.3 V logic anyway.&lt;br&gt;&amp;#8226; Keep SPI leads short (&amp;lt; 10 cm) on the breadboard; the firmware runs SPI at 4 MHz for this reason.&lt;br&gt;&amp;#8226; IRQ (dashed) is optional - the firmware polls; leave it unconnected if you are short of pins.&lt;br&gt;&amp;#8226; Check with a multimeter: 3.3 V across module header pins 1-2 under load, before the first pio run -t upload." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontSize=10;" vertex="1" parent="1"><mxGeometry x="860" y="730" width="520" height="170" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="TX fallback - Arduino Nano" id="TX_fallback_Arduino_Nano"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="900" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="Transmitter (fallback): Arduino Nano  +  nRF24L01+ PA+LNA via external 3.3 V regulator" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1100" height="40" as="geometry"/></mxCell><mxCell id="c2" value="REII checkpoint - nRF24L01+ (PA+LNA) link bring-up. Pin numbers are GPIO numbers as used in firmware/lib/linktest/board_pins.h; see docs/02_wiring.md." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="60" width="1100" height="24" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b&gt;Arduino Nano&lt;/b&gt;&lt;br&gt;ATmega328P, 5 V logic board - role: tx&lt;br&gt;(fallback only)" style="rounded=1;whiteSpace=wrap;html=1;strokeWidth=2;fontSize=13;fillColor=#E1D5E7;verticalAlign=top;spacingTop=8;fontSize=14;" vertex="1" parent="1"><mxGeometry x="120" y="140" width="300" height="560" as="geometry"/></mxCell><mxCell id="c4" value="GND" style="rounded=0;whiteSpace=wrap;html=1;strokeWidth=1;fontSize=11;fillColor=#FFFFFF;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="330" y="250" width="90" height="26" as="geometry"/></mxCell><mxCell id="c5" value="+5V" style="rounded=0;whiteSpace=wrap;html=1;strokeWidth=1;fontSize=11;fillColor=#FFFFFF;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="330" y="302" width="90" height="26" as="geometry"/></mxCell><mxCell id="c6" value="pin 27 - NOT the 3V3 pin" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontSize=10;fontColor=#555555;align=right;" vertex="1" parent="1"><mxGeometry x="132" y="300" width="190" height="30" as="geometry"/></mxCell><mxCell id="c7" value="D9" style="rounded=0;whiteSpace=wrap;html=1;strokeWidth=1;fontSize=11;fillColor=#FFFFFF;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="330" y="354" width="90" height="26" as="geometry"/></mxCell><mxCell id="c8" value="D10" style="rounded=0;whiteSpace=wrap;html=1;strokeWidth=1;fontSize=11;fillColor=#FFFFFF;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="330" y="406" width="90" height="26" as="geometry"/></mxCell><mxCell id="c9" value="hardware SS" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontSize=10;fontColor=#555555;align=right;" vertex="1" parent="1"><mxGeometry x="132" y="404" width="190" height="30" as="geometry"/></mxCell><mxCell id="c10" value="D13" style="rounded=0;whiteSpace=wrap;html=1;strokeWidth=1;fontSize=11;fillColor=#FFFFFF;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="330" y="458" width="90" height="26" as="geometry"/></mxCell><mxCell id="c11" value="hardware SPI" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontSize=10;fontColor=#555555;align=right;" vertex="1" parent="1"><mxGeometry x="132" y="456" width="190" height="30" as="geometry"/></mxCell><mxCell id="c12" value="D11" style="rounded=0;whiteSpace=wrap;html=1;strokeWidth=1;fontSize=11;fillColor=#FFFFFF;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="330" y="510" width="90" height="26" as="geometry"/></mxCell><mxCell id="c13" value="hardware SPI" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontSize=10;fontColor=#555555;align=right;" vertex="1" parent="1"><mxGeometry x="132" y="508" width="190" height="30" as="geometry"/></mxCell><mxCell id="c14" value="D12" style="rounded=0;whiteSpace=wrap;html=1;strokeWidth=1;fontSize=11;fillColor=#FFFFFF;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="330" y="562" width="90" height="26" as="geometry"/></mxCell><mxCell id="c15" value="hardware SPI" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontSize=10;fontColor=#555555;align=right;" vertex="1" parent="1"><mxGeometry x="132" y="560" width="190" height="30" as="geometry"/></mxCell><mxCell id="c16" value="D2" style="rounded=0;whiteSpace=wrap;html=1;strokeWidth=1;fontSize=11;fillColor=#FFFFFF;fontFamily=Courier New;" vertex="1" parent="1"><m